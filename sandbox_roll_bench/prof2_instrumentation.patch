+        s(&PROF2_WORK), s(&PROF2_ROLL), s(&PROF2_PREFLIGHT), s(&PROF_NEU), s(&PROF_BT_NEU),
+        s(&PROF2_MAINLOOP), s(&PROF2_SER), s(&PROF2_FSWRITE), s(&PROF2_MERGE), s(&PROF2_STATUS),
+        s(&PROF2_WALL),
+    );
+}
