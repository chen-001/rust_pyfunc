+pub(crate) fn prof2_add(counter: usize, ns: u64) {
+    let c = match counter {
+        0 => &PROF2_ROLL,
+        1 => &PROF2_PREFLIGHT,
+        2 => &PROF2_READ,
+        3 => &PROF2_WORK,
+        4 => &PROF2_SER,
+        5 => &PROF2_FSWRITE,
+        6 => &PROF2_MERGE,
+        7 => &PROF2_STATUS,
+        8 => &PROF2_MAINLOOP,
+        _ => &PROF2_WALL,
+    };
+    c.fetch_add(ns, AtomicOrdering::Relaxed);
+}
