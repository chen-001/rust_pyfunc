 /// Sentinel padding is never part of the returned 500 keys. No floating-point arithmetic.
 pub fn sort_keys(keys: &mut [u64], scratch: &mut [u64]) {
+    // Default-off sandbox experiment. Resolve the environment once, outside the
+    // numerical loop. Padding is greater than every real key and is discarded.
+    #[cfg(target_arch = "x86_64")]
+    if keys.len() == 100 && scratch.len() >= 128 && is_x86_feature_detected!("avx512f") {
+        static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        if *ENABLED.get_or_init(|| std::env::var_os("YUPEI_SORT100_SIMD").is_some()) {
+            // Quantized ties often arrive in index order. Preserve the standard
+            // sorter's cheap monotone cases before paying for the fixed network.
+            if keys[0] <= keys[1] {
+                if keys.is_sorted() { return; }
+            } else if keys.is_sorted_by(|a, b| a >= b) {
+                keys.reverse();
+                return;
+            }
+            scratch[..100].copy_from_slice(keys);
+            scratch[100..128].fill(u64::MAX);
+            unsafe { network128(scratch.as_mut_ptr()); }
+            keys.copy_from_slice(&scratch[..100]);
+            return;
+        }
+    }
