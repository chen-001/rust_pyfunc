+#[pyfunction]
+pub fn py_dagpath(_py: Python<'_>, code: &str, date: i64) -> PyResult<Vec<f32>> {
+    compute_dagpath_full(code, date)
+        .map_err(|e| pyo3::exceptions::PyIOError::new_err(format!("{:?}", e)))
+}
