+#[pyfunction]
+pub fn py_dijkstra(py: Python<'_>, date: i64) -> PyResult<(Vec<String>, Vec<f32>)> {
+    compute_dijkstra_full(date)
+        .map_err(|e| pyo3::exceptions::PyIOError::new_err(format!("{e:?}")))
+}
