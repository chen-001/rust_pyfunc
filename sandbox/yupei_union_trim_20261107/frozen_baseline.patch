-// ====================== 三元组：8 格统计 ======================
-const NT: usize = 3; // 目标个数：r60, r300, nd
-#[derive(Clone)]
-struct C3 {
-    n: usize,
-    cnt: [u32; 8],
-    jt: [u32; 64],
-    marg: [f64; 3],
-    // 全样本 & 前后两半：每格目标的 计数/和；每半的 Σy²
-    tn: [[u32; 8]; NT],
-    ts: [[f64; 8]; NT],
-    hn: [[[u32; 8]; NT]; 2],
-    hs: [[[f64; 8]; NT]; 2],
-    hss: [[f64; NT]; 2],
-}
-fn c3_of(a: &[u8], b: &[u8], c: &[u8], tg: [&[f32]; NT]) -> C3 {
-    let n = a.len();
-    let mut z = C3 {
-        n,
-        cnt: [0; 8],
-        jt: [0; 64],
-        marg: [0.; 3],
-        tn: [[0; 8]; NT],
-        ts: [[0.; 8]; NT],
-        hn: [[[0; 8]; NT]; 2],
-        hs: [[[0.; 8]; NT]; 2],
-        hss: [[0.; NT]; 2],
-    };
-    if n == 0 {
-        return z;
-    }
-    let half = n / 2;
-    let mut prev = 8usize;
-    for i in 0..n {
-        let cell = ((a[i] as usize) << 2) | ((b[i] as usize) << 1) | c[i] as usize;
-        z.cnt[cell] += 1;
-        z.marg[0] += a[i] as f64;
-        z.marg[1] += b[i] as f64;
-        z.marg[2] += c[i] as f64;
-        if prev < 8 {
-            z.jt[prev * 8 + cell] += 1;
-        }
-        prev = cell;
-        let h = (i >= half) as usize;
-        for k in 0..NT {
-            let y = tg[k][i];
-            if !y.is_finite() {
-                continue;
-            }
-            let y = y as f64;
-            z.tn[k][cell] += 1;
-            z.ts[k][cell] += y;
-            z.hn[h][k][cell] += 1;
-            z.hs[h][k][cell] += y;
-            z.hss[h][k] += y * y;
-        }
-    }
-    for m in z.marg.iter_mut() {
-        *m /= n as f64;
-    }
-    z
-}
-/// 在 h_train 半段学「每格的目标均值」，在另一半算预测值与真实目标的相关
-fn c3_oos(z: &C3, k: usize, h_train: usize) -> f64 {
-    let ht = 1 - h_train;
-    let tot_n: u32 = z.hn[h_train][k].iter().sum();
-    if tot_n < 100 {
-        return f64::NAN;
-    }
-    let gm = z.hs[h_train][k].iter().sum::<f64>() / tot_n as f64;
-    let mut pred = [0f64; 8];
-    for c in 0..8 {
-        let nn = z.hn[h_train][k][c];
-        // 格内样本少就向整体均值收缩
-        pred[c] = (z.hs[h_train][k][c] + 20.0 * gm) / (nn as f64 + 20.0);
-    }
-    let (mut n, mut sp, mut sy, mut spp, mut spy) = (0f64, 0f64, 0f64, 0f64, 0f64);
-    for c in 0..8 {
-        let nn = z.hn[ht][k][c] as f64;
-        n += nn;
-        sp += pred[c] * nn;
-        spp += pred[c] * pred[c] * nn;
-        sy += z.hs[ht][k][c];
-        spy += pred[c] * z.hs[ht][k][c];
-    }
-    if n < 100.0 {
-        return f64::NAN;
-    }
-    let syy = z.hss[ht][k];
-    let cov = spy / n - sp / n * sy / n;
-    let vp = spp / n - (sp / n).powi(2);
-    let vy = syy / n - (sy / n).powi(2);
-    if vp <= 1e-18 || vy <= 1e-18 {
-        return f64::NAN;
-    }
-    cov / (vp * vy).sqrt()
-}
-/// 109 个「三个输入都用到、且取反只留一个（f(000)=0）」的三元布尔函数
-fn canon_funcs() -> Vec<usize> {
-    (0..256usize)
-        .filter(|&f| {
-            if f & 1 == 1 {
-                return false;
-            }
-            (0..3).all(|k| (0..8).any(|c| ((f >> c) & 1) != ((f >> (c ^ (1 << k))) & 1)))
-        })
-        .collect()
-}
-const FSTATS: &[&str] = &["ac1", "lks", "lksx", "e60", "end"];
-fn func_stat(z: &C3, f: usize, st: usize) -> f64 {
-    let n = z.n;
-    if n < 200 {
-        return f64::NAN;
-    }
-    let nf = n as f64;
-    let bit = |c: usize| (f >> c) & 1;
-    match st {
-        0 => {
-            let p1 = (0..8).map(|c| bit(c) as f64 * z.cnt[c] as f64).sum::<f64>() / nf;
-            let mut p11 = 0.0;
-            for c1 in 0..8 {
-                if bit(c1) == 1 {
-                    for c2 in 0..8 {
-                        if bit(c2) == 1 {
-                            p11 += z.jt[c1 * 8 + c2] as f64;
-                        }
-                    }
-                }
-            }
-            p11 /= (n - 1) as f64;
-            let var = p1 * (1.0 - p1);
-            if var <= 1e-12 {
-                return f64::NAN;
-            }
-            (p11 - p1 * p1) / var
-        }
-        1 | 2 => {
-            // 取反不变的「泄露」：max_i |2·P(z==x_i) - 1|；lksx 再减去三路独立时的同一量
-            let (mut mx, mut mxb) = (0f64, 0f64);
-            for who in 0..3 {
-                let (mut lk, mut lkb) = (0.0, 0.0);
-                for c in 0..8 {
-                    let xbit = (c >> (2 - who)) & 1;
-                    let mut pb = 1.0;
-                    for w in 0..3 {
-                        let p = z.marg[w];
-                        pb *= if (c >> (2 - w)) & 1 == 1 {
-                            p
-                        } else {
-                            1.0 - p
-                        };
-                    }
-                    if bit(c) == xbit {
-                        lk += z.cnt[c] as f64 / nf;
-                        lkb += pb;
-                    }
-                }
-                mx = mx.max((2.0 * lk - 1.0).abs());
-                mxb = mxb.max((2.0 * lkb - 1.0).abs());
-            }
-            if st == 1 {
-                mx
-            } else {
-                mx - mxb
-            }
-        }
-        3 | 4 => {
-            let k = if st == 3 { 0 } else { 2 };
-            let (mut n1, mut s1, mut n0, mut s0) = (0u32, 0f64, 0u32, 0f64);
-            for c in 0..8 {
-                if bit(c) == 1 {
-                    n1 += z.tn[k][c];
-                    s1 += z.ts[k][c];
-                } else {
-                    n0 += z.tn[k][c];
-                    s0 += z.ts[k][c];
-                }
-            }
-            if n1 < 30 || n0 < 30 {
-                return f64::NAN;
-            }
-            s1 / n1 as f64 - s0 / n0 as f64
-        }
-        _ => f64::NAN,
-    }
-}
