+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+pub(crate) struct TopkSelectionDiag {
+    pub calls: u64,
+    pub high_first_calls: u64,
+    pub wide_first_calls: u64,
+    pub first_shortfalls: u64,
+    pub retry_scans: u64,
+    pub full_key_fallbacks: u64,
+    pub first_candidates: u64,
+    pub retry_candidates: u64,
+}
+
+impl TopkSelectionDiag {
+    pub(crate) fn add(&mut self, rhs: &Self) {
+        self.calls += rhs.calls;
+        self.high_first_calls += rhs.high_first_calls;
+        self.wide_first_calls += rhs.wide_first_calls;
+        self.first_shortfalls += rhs.first_shortfalls;
+        self.retry_scans += rhs.retry_scans;
+        self.full_key_fallbacks += rhs.full_key_fallbacks;
+        self.first_candidates += rhs.first_candidates;
+        self.retry_candidates += rhs.retry_candidates;
+    }
+}
