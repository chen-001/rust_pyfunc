+                    if n_mid > need {
+                        mid.select_nth_unstable(need - 1);
+                    }
+                    kh[n_hi..take].copy_from_slice(&mid[..need]);
+                    kh[..take].sort_unstable();
+                    return;
+                }
+            }
+        }
+    }
+    for x in 0..n {
+        kh[x] = pack_desc_idx_asc(scores[x], x as u32);
+    }
+    kh.select_nth_unstable(take - 1);
+    kh[..take].sort_unstable();
+}
