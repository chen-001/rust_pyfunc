+                }
+                if b2[i] > mx_g {
+                    mx_g = b2[i];
+                }
+            }
+            let mut b3 = [0f32; 8];
+            let mut b4 = [0f32; 8];
+            let mut b5 = [0f32; 8];
+            _mm256_storeu_ps(b3.as_mut_ptr(), sh);
+            _mm256_storeu_ps(b4.as_mut_ptr(), sg);
+            _mm256_storeu_ps(b5.as_mut_ptr(), sq);
