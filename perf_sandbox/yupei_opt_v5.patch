+                        let xx = x + i;
+                        let mut h = wb * p[xx] + wc * q[xx] + addm[xx];
+                        let mut g = h - if p[xx] > q[xx] { p[xx] } else { q[xx] };
+                        if xx == b || xx == c {
+                            h = f32::NEG_INFINITY;
+                            g = f32::NEG_INFINITY;
+                        }
+                        hbuf[i] = h;
+                        gbuf[i] = g;
+                    }
+                    for i in 0..8 {
+                        hb[x + i] = hbuf[i];
+                        gb[x + i] = gbuf[i];
+                    }
+                    hv = _mm256_loadu_ps(hbuf.as_ptr());
+                    gv = _mm256_loadu_ps(gbuf.as_ptr());
