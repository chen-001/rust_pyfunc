+            let mut b1 = [0f32; 8];
+            let mut b2 = [0f32; 8];
+            _mm256_storeu_ps(b1.as_mut_ptr(), mh);
+            _mm256_storeu_ps(b2.as_mut_ptr(), mg);
+            let (mut mx_h, mut mx_g) = (f32::NEG_INFINITY, f32::NEG_INFINITY);
+            for i in 0..8 {
