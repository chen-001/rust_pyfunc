+                    let c = _mm256_cmp_ps::<_CMP_EQ_OQ>(_mm256_loadu_ps(g.as_ptr().add(x)), mg);
+                    let mask = _mm256_movemask_ps(c) as u32;
+                    if mask != 0 {
+                        bsi = x + mask.trailing_zeros() as usize;
+                    }
+                }
+                if bi != usize::MAX && (bsi != usize::MAX || !find_g) {
+                    return (bi, bsi);
+                }
+                x += 8;
+            }
+            while x < n {
